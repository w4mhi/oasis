# Python
.venv/
__pycache__/
*.pyc
*.pyo
.claude/*
specs/
tests/__pycache__/

# Per-machine runtime state — written by setup-oasis.py (which features are
# installed); the dashboard reads it to hide not-installed service cards.
configuration/installed-services.json

# Operator identity (callsign + grid) seeded by setup-oasis.py; per-machine.
configuration/station.json

# Operator-placed folder mount mappings (shared runtime state, not repo content).
configuration/user-folders.json

# Operator-placed APRS map warnings (shared runtime state, not repo content).
aprs-warnings.json
aprs-warnings.json.tmp

# Screenshot / demo tooling — local mock backends used to populate the
# dashboard & APRS map with fake data for documentation captures.
mock-up/

# macOS
.DS_Store

# ── Large data — never checked in, to keep the repo footprint small ────────────

# Offline map tiles — built by scripts/build-map.py (or copied in).
*.mbtiles
*.pmtiles

# PDF radio manuals — large and license-encumbered; distributed separately.
# Drop your own PDFs into static/radio-manuals/ on the target machine. The whole
# folder is excluded (PDFs and any other binaries) except this README.
static/radio-manuals/*
!static/radio-manuals/README.md

# Wikipedia ZIM files — downloaded by scripts/download-wikipedia.py.
*.zim

# FCC amateur-radio database — built by scripts/install-fcc-database.py into
# fcc-offline-database/data/ (see server/lookup.py). Large, and the raw FCC dump
# carries licensee names/addresses — never checked in; each machine builds its own.
fcc-offline-database/

# Scratch / temporary files
temp/

# USB bundle output — built by scripts/create-oasis-offline.py
oasis-offline/
oasis-offline-windows/

# Python wheels — downloaded by scripts/create-oasis-offline.py.
# Never checked in; populated at bundle-build time.
server/wheels/*.whl

# Feature-local vendored wheels (e.g. features/geek-pi-case/wheels/rpi_ws281x-*.whl).
# Kept in the feature dir for clean removal; bundled into the offline image, not git.
features/*/wheels/*.whl

# Feature-local vendored packages (e.g. features/rtl-sdr/packages/{rtl-sdr,direwolf}/<suite>/*.deb,
# displays/cm4stack/packages/m5stack-cm4.dtbo). Co-located with the feature for
# clean removal; bundled into the offline image, not git.
features/*/packages/**/*.deb
displays/*/packages/**/*.dtbo

# Service-local vendored packages (e.g. services/adsb/packages/dump1090-fa/<suite>/*.deb).
# Same pattern as features/*/packages above, for services/.
services/*/packages/**/*.deb

# Offline binary packages — downloaded by scripts/create-oasis-offline.py.
# Entire tree is excluded; scripts install from oasis-offline/ or the internet.
offline-packages/
maps/tiles/

# M5Stack CM4Stack overlay — fetched at build time / dropped manually, never committed.
displays/cm4stack/overlays/*.dtbo

# RepeaterBook data .
static/repeaterbook/*.csv
static/chirp/*.csv
!static/chirp/chirp-sample.csv

# ICS-205 saved plans — written at runtime by /api/save-ics205, never committed.
static/ics-205/saved/

# RTL-SDR tuning bench results — written at runtime by tune-rtl-sdr.py, never committed.
features/rtl-sdr/tune-results.json

# RTL-SDR tuning bench Direwolf conf — written into the operator's cwd by
# tune-rtl-sdr.py (reused if present); a runtime artifact, never committed.
rtl-sdr-direwolf.conf

# Personal Claude Code instructions (private)
CLAUDE.local.md
docs/superpowers/*

# Local Claude Code settings (private hooks/permissions)
.claude/settings.local.json
.superpowers/
