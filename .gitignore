# Python
.venv/
__pycache__/
*.pyc
*.pyo
.claude/*

# Per-machine runtime state — written by setup-oasis.py (which features are
# installed); the dashboard reads it to hide not-installed service cards.
installed-services.json

# Operator identity (callsign + grid) seeded by setup-oasis.py; per-machine.
station.json

# Operator-placed APRS map warnings (shared runtime state, not repo content).
aprs-warnings.json
aprs-warnings.json.tmp

# Screenshot / demo tooling — local mock backends used to populate the
# dashboard & APRS map with fake data for documentation captures.
mock-up/

# macOS
.DS_Store

# ── Large data — never checked in, to keep the repo footprint small ────────────

# Offline map tiles — built by scripts/build-map.py (or copied in).
*.mbtiles
*.pmtiles

# pmtiles CLI binary — downloaded manually into maps/ for local conversion use,
# and vendored per-platform into the bundle by create-oasis-offline.py.
maps/pmtiles
maps/pmtiles-*

# PDF radio manuals — large and license-encumbered; distributed separately.
# Drop your own PDFs into radio-manuals/ on the target machine. The whole
# folder is excluded (PDFs and any other binaries) except this README.
radio-manuals/*
!radio-manuals/README.md

# FCC offline database — directory is created locally by setup-fcc-database.py
# and populated in oasis-offline/ by create-oasis-offline.py. Nothing is checked in.
fcc-offline-database/

# Wikipedia ZIM files — downloaded by scripts/download-wikipedia.py.
*.zim

# Scratch / temporary files
temp/

# USB bundle output — built by scripts/create-oasis-offline.py
oasis-offline/

# Python wheels — downloaded by scripts/create-oasis-offline.py.
# Never checked in; populated at bundle-build time.
server/wheels/*.whl

# Offline binary packages — downloaded by scripts/create-oasis-offline.py.
# Entire tree is excluded; scripts install from oasis-offline/ or the internet.
offline-packages/

# RepeaterBook data .
repeaterbook/*.csv

# Personal Claude Code instructions (private)
CLAUDE.local.md

# Local Claude Code settings (private hooks/permissions)
.claude/settings.local.json
