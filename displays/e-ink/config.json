{
  "branding": {
    "title": "OASIS",
    "subtitle": "Off-grid Amateur Station Information Suite",
    "motto": "Comms when the network's gone dark."
  },

  "splash_seconds": 4,
  "default_screen": 1,

  "station": {
    "source": "../../station.json"
  },

  "oasis": {
    "base_url": "http://127.0.0.1:8083",
    "http_timeout_s": 5
  },

  "display": {
    "model": "epd2in7",
    "width": 264,
    "height": 176,
    "rotate": 0,
    "flip_180": false,
    "preview_path": "preview.png",
    "preview_scale": 3
  },

  "refresh": {
    "tick_s": 60,
    "full_every_s": 1800
  },

  "clock": {
    "show": ["LOC", "UTC"],
    "local_tz": "America/Los_Angeles",
    "hour24": true
  },

  "buttons": {
    "KEY1": 5,
    "KEY2": 6,
    "KEY3": 13,
    "KEY4": 19,
    "long_press_ms": 600
  },

  "services": {
    "order": ["LIVE", "API", "FEED", "NET", "GPS"],
    "LIVE": { "label": "LIVE", "source": "oasis",    "probe": "/health" },
    "API":  { "label": "API",  "source": "oasis",    "probe": "/api/aprs/health" },
    "FEED": { "label": "FEED", "source": "oasis",    "probe": "/api/aprs/stations", "stale_s": 600 },
    "NET":  { "label": "NET",  "source": "internet", "probe": "https://www.hamqsl.com" },
    "GPS":  { "label": "GPS",  "source": "system",   "field": "gps" }
  },

  "system": {
    "show": ["CPU", "RAM", "TEMP", "IP"],
    "source": "/api/system"
  },

  "weather": {
    "enabled": true,
    "provider": "owm",
    "units": "imperial",
    "owm_api_key_env": "OWM_API_KEY",
    "owm_api_key_file": "weather-secrets.json",
    "location_label": "",
    "cache_s": 900,
    "cache_path": "weather-cache.json",
    "mini_days": 3,
    "forecast_days": 5,
    "alerts": {
      "enabled": true,
      "provider": "nws",
      "url": "https://api.weather.gov/alerts/active"
    }
  },

  "propagation": {
    "enabled": true,
    "provider": "hamqsl",
    "url": "https://www.hamqsl.com/solarxml.php",
    "cache_s": 900
  },

  "winlink": {
    "mailbox": "in",
    "seen_state_path": "winlink-seen.json"
  },

  "fonts": {
    "regular": null,
    "bold": null
  }
}
