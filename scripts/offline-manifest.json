        {
          "name": "Flask",
          "version": "3.1.3"
        },
        {
          "name": "MarkupSafe",
          "version": "3.0.3"
        },
        {
          "name": "gunicorn",
          "version": ">=23.0.0,<27",
          "skip_on": [
            "windows"
          ]
        },
        {
          "name": "psutil",
          "version": "7.2.2"
        }
      ],
      "resolved": {}
    },
